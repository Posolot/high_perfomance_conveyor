{
  "frame": {
    "width": 1920,
    "height": 1080,
    "channels": 1
  },
  "buffer_size": 250,
  "runtime": {
    "physical_cores": 4,
    "logical_cpus": 8,
    "cpu_budget": 8
  },
  "ipconfig": {
    "ip": "127.0.0.1",
    "port": 5558,
    "protocol": "tcp",
    "socket_type": "PULL"
  },
  "stages": [
    {
      "name": "show_stage",
      "callable": "show",
      "next": [
        "blur_stage"],
      "initial_workers": 1,
      "min_workers": 1,
      "max_workers": 1
    },
    {
      "name": "blur_stage",
      "callable": "blur",
      "next": [
        "display_stage"
      ],
      "initial_workers": 1,
      "min_workers": 1,
      "max_workers": 4
    },
    {
      "name": "display_stage",
      "callable": "show",
      "next": [],
      "initial_workers": 1,
      "min_workers": 1,
      "max_workers": 1
    }
  ]
}