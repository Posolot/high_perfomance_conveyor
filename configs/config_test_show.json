{
  "frame": {
    "width": 1280,
    "height": 720,
    "channels": 3
  },
  "buffer_size": 1000,
  "runtime": {
    "physical_cores": 4,
    "logical_cpus": 8,
    "cpu_budget": 8
  },
  "ipconfig": {
    "ip": "127.0.0.1",
    "port": 5558,
    "protocol": "tcp",
    "socket_type": "PULL"
  },
  "stages": [
    {
      "name": "gray_stage",
      "callable": "rgb2gray",
      "next": [
        "blur_stage"],
      "initial_workers": 2,
      "min_workers": 2,
      "max_workers": 4
    },
    {
      "name": "blur_stage",
      "callable": "blur",
      "next": [
        "save_stage"
      ],
      "initial_workers": 2,
      "min_workers": 2,
      "max_workers": 4
    },
    {
      "name": "save_stage",
      "callable": "save",
      "next": [
        "display_stage"
      ],
      "initial_workers": 1,
      "min_workers": 1,
      "max_workers": 1
    },
    {
      "name": "display_stage",
      "callable": "show",
      "next": [],
      "initial_workers": 1,
      "min_workers": 1,
      "max_workers": 1
    }
  ]
}