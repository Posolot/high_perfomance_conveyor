{
  "frame": {
    "width": 1920,
    "height": 1080,
    "channels": 1
  },
  "buffer_size": 250,
  "runtime": {
    "physical_cores": 4,
    "logical_cpus": 8,
    "cpu_budget": 8
  },
  "ipconfig": {
    "ip": "127.0.0.1",
    "port": 5558,
    "protocol": "tcp",
    "socket_type": "PULL"
  },
  "stages": [
    {
      "name": "gray_stage",
      "callable": "rgb2gray",
      "next": [
        "erode_stage",
        "blur_stage",
        "gaussian_stage"
      ],
      "initial_workers": 1,
      "min_workers": 1,
      "max_workers": 4
    },
    {
      "name": "erode_stage",
      "callable": "erode",
      "next": [
        "merge_stage"
      ],
      "initial_workers": 1,
      "min_workers": 1,
      "max_workers": 4
    },
    {
      "name": "blur_stage",
      "callable": "blur",
      "next": [
        "merge_stage"
      ],
      "initial_workers": 1,
      "min_workers": 1,
      "max_workers": 4
    },
    {
      "name": "gaussian_stage",
      "callable": "blur",
      "next": [
        "merge_stage"
      ],
      "initial_workers": 1,
      "min_workers": 1,
      "max_workers": 4
    },
    {
      "name": "merge_stage",
      "callable": "merge",
      "next": [
        "heavy_stage"
      ],
      "initial_workers": 1,
      "min_workers": 1,
      "max_workers": 4
    },
    {
      "name": "heavy_stage",
      "callable": "heavy",
      "next": [],
      "initial_workers": 2,
      "min_workers": 2,
      "max_workers": 4
    }
  ]
}